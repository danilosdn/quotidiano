{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "src/game/config/constants.ts",
    "src/game/time/**/*.ts",
    "src/game/inventory/**/*.ts",
    "src/game/interactions/**/*.ts",
    "src/game/state/**/*.ts",
    "src/game/dialogue/IntentMatcher.ts",
    "src/game/dialogue/types.ts",
    "src/game/navigation/PathFinder.ts",
    "src/game/navigation/houseNavigation.ts",
    "src/data/interactions/homeInteractions.ts",
    "src/game/house/**/*.ts",
    "src/game/entities/playerFrameMap.ts",
    "src/data/language/**/*.ts",
    "src/data/scenarios/**/*.ts",
    "src/data/dialogues/homeContent.ts",
    "src/data/phone/**/*.ts",
    "src/game/language/**/*.ts",
    "src/game/dialogue/ScriptedDialogueProvider.ts",
    "src/game/house/actions/**/*.ts",
    "src/game/house/rooms/**/*.ts"
  ],
  "exclude": [
    "src/game/house/HouseRenderer.ts",
    "src/game/house/HouseAssetManifest.ts"
  ]
}
