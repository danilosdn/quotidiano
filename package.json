{
  "name": "quotidiano",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run check && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "check": "tsc -p tsconfig.app.json --pretty false && tsc -p tsconfig.node.json --pretty false",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "audit:assets": "node --experimental-strip-types scripts/audit-assets.ts incoming-assets",
    "asset-browser": "vite tools/asset-browser --host 127.0.0.1",
    "check:core": "tsc -p tsconfig.core.json --pretty false",
    "validate:house": "node scripts/run-typescript-script.mjs scripts/validate-house-v3.ts",
    "test:offline": "node scripts/run-typescript-script.mjs scripts/offline-test-suite.ts",
    "validate:assets": "python3 scripts/validate-runtime-assets.py",
    "validate:boundaries": "node scripts/validate-house-content-boundaries.mjs",
    "validate:local": "npm run check:core && npm run check:app-offline && npm run check:tests-offline && npm run validate:scene-members && npm run validate:artifacts && npm run validate:house && npm run test:offline && npm run validate:assets && npm run validate:boundaries",
    "sprite-inspector": "vite --config tools/sprite-frame-inspector/vite.config.ts",
    "check:app-offline": "node scripts/check-app-offline.mjs",
    "check:tests-offline": "node scripts/check-tests-offline.mjs",
    "validate:scene-members": "node scripts/audit-scene-member-collisions.mjs",
    "check:readonly": "node scripts/check-readonly-typecheck.mjs",
    "validate:artifacts": "node scripts/audit-typescript-artifacts.mjs"
  },
  "dependencies": {
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "@playwright/test": "1.50.1",
    "@types/node": "22.10.10",
    "typescript": "5.7.3",
    "vite": "6.1.0",
    "vitest": "3.0.5"
  },
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": "22.16.x",
    "npm": "10.9.x"
  }
}
