{
  "name": "quotidiano",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "check": "tsc -b --pretty false",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "audit:assets": "node --experimental-strip-types scripts/audit-assets.ts incoming-assets",
    "asset-browser": "vite tools/asset-browser --host 127.0.0.1",
    "check:core": "tsc -p tsconfig.core.json --pretty false"
  },
  "dependencies": {
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "@playwright/test": "1.50.1",
    "@types/node": "22.10.10",
    "typescript": "5.7.3",
    "vite": "6.1.0",
    "vitest": "3.0.5"
  }
}
